{
  "name": "crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src next.config.ts eslint.config.mjs",
    "format": "prettier --write src *.ts *.mjs package.json tsconfig.json pnpm-workspace.yaml .prettierrc.json",
    "format:check": "prettier --check src *.ts *.mjs package.json tsconfig.json pnpm-workspace.yaml .prettierrc.json",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
