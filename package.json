{
  "name": "crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern \".claude/**\" --ignore-pattern \".rsc/**\" --ignore-pattern \"01-TOOLS/**\" --ignore-pattern \"02-DOCS/**\" --ignore-pattern \"coverage/**\" --ignore-pattern \"playwright-report/**\" --ignore-pattern \"test-results/**\"",
    "format": "prettier --write . \"!.rsc.json\"",
    "format:check": "prettier --check . \"!.rsc.json\"",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
