# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Local values: `npx -y supabase@3.4.0 status -o env` → API_URL, PUBLISHABLE_KEY, SECRET_KEY.

# Browser-safe (copied into browser code at build time)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
